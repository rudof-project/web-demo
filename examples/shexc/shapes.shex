# Several shapes: references, closed shapes, EXTRA, AND / OR / NOT
prefix : <http://example.org/>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

start = @:Person

:Person EXTRA rdf:type {
  rdf:type [ foaf:Person ] ;
  foaf:name xsd:string ;
  foaf:knows @:Person * ;
  :worksFor @:Company ?
}

:Company CLOSED {
  :name xsd:string ;
  :employee @:Employee +
}

:Employee @:Person AND { :salary xsd:decimal }

:Contact @:Person OR @:Company

:NotACompany NOT @:Company
